
import java.util.*;
///A class que vai ajuda a molda e "orientar" o objeto
class Aluno{
 private  String Nome;
  private double NotaP;
   private double NotaB;
    private double Media;

  public Aluno(String Nome, double NotaP,double NotaB){
    this.Nome = Nome;
    this.NotaP =  NotaP;
    this.NotaB = NotaB;
    
  }
  double CalculoDenota(){
    Media =  (NotaP + NotaB) / 2;
    return Media;
  }

  boolean ValidoOuNao(){
  if (NotaP > 10 || NotaP < 0 || NotaB > 10 || NotaB < 0 || Media > 10 || Media < 0){
    System.out.printf("ERRO!! - Por favor digite um numero valido de 0 a 10 %n%n");
   return false;
  } else{
return true;
  }
  }
public String getNome() {
    return Nome;
}
  public String toString(){
  CalculoDenota();
  ValidoOuNao();
  return String.format ("|| aluno: %s ||%n ||tirou: %.2f na parcial||%n tirou: %.2f na bimestral||%n || media geral foi: %.2f ||%n",Nome,NotaP,NotaB,Media);
  }
  }

